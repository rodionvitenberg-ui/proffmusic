# ============================================
# ProffMusic - Environment Variables
# ============================================

# --- Django ---
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=proffmusic.shop,www.proffmusic.shop,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://proffmusic.shop,https://www.proffmusic.shop,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://proffmusic.shop,https://www.proffmusic.shop,http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL) ---
DB_NAME=musicbase_db
DB_USER=musicuser
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=5433

# --- Email (Gmail SMTP) ---
# Для Gmail используйте App Password (пароль приложения), а не обычный пароль.
# Создать: https://myaccount.google.com/apppasswords (нужна включённая 2FA)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=ProffMusic <your-email@gmail.com>

# --- Site ---
SITE_URL=https://proffmusic.shop

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=https://proffmusic.shop
NEXT_PUBLIC_SITE_URL=https://proffmusic.shop

# --- Payments ---
PAYMENTS_BACKEND=mock
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=